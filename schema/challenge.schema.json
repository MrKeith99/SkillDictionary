{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robocupathome.org/schema/challenge.schema.json",
  "title": "RoboCup@Home challenge scoresheet",
  "description": "References the dictionary by id. Carries NO points field, so cross-challenge price drift is structurally unrepresentable.",
  "type": "object",
  "required": ["challenge", "rulebook_section", "total_score", "entries"],
  "properties": {
    "challenge": {"type": "string"},
    "rulebook_section": {"type": "string"},
    "max_time_minutes": {"type": "integer"},
    "total_score": {"type": "integer"},
    "method_note": {"type": "string"},
    "dictionary_ref": {"type": "string"},
    "global_rules_ref": {"type": "string"},
    "challenge_rules": {"type": "object"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref"],
        "additionalProperties": false,
        "properties": {
          "ref": {"type": "string", "pattern": "^[A-Z]+(-[A-Z]+)?-[0-9]{2,}[A-Z]?[0-9]*$"},
          "count": {"type": "integer", "minimum": 1},
          "section": {"type": "string"},
          "related_skill": {"type": "string"},
          "note": {"type": "string"},
          "ambiguity": {"type": "string"},
          "depends_on": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["ref"],
              "properties": {
                "ref": {"type": "string"},
                "nature": {"enum": ["informational", "physical", "sequential"]},
                "blocking": {"type": "boolean"},
                "satisfiable_by_assistance": {"type": "boolean"},
                "note": {"type": "string"},
                "unresolved": {"type": "boolean"}
              }
            }
          },
          "assistance": {
            "type": "object",
            "properties": {
              "permitted": {"type": "boolean"},
              "listed_in_task_description": {"type": "boolean"},
              "self_score": {"type": "integer"},
              "extra_penalty_ref": {"type": ["string", "null"]},
              "extra_penalty": {"type": "integer"},
              "blocks_dependents": {"type": "boolean", "default": false},
              "note": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
