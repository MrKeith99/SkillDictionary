{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robocupathome.org/schema/challenge.schema.json",
  "title": "RoboCup@Home challenge scoresheet",
  "description": "References the dictionary by id. Carries NO points field, so cross-challenge price drift is structurally unrepresentable.",
  "type": "object",
  "required": ["challenge", "rulebook_section", "total_score", "entries"],
  "properties": {
    "challenge": {"type": "string"},
    "rulebook_section": {"type": "string"},
    "max_time_minutes": {"type": "integer"},
    "total_score": {"type": "integer", "description": "Derived by the build (dist/ only): max_score, or the sum of the reward lines."},
    "max_score": {"type": "integer", "description": "Set when not every variant is reachable in one run (e.g. GPSR commands)."},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref"],
        "additionalProperties": false,
        "properties": {
          "ref": {"type": "string", "pattern": "^[A-Z]+(-[A-Z]+)?-[0-9]{2,}[A-Z]?[0-9]*(-[A-Z]+[0-9]*)?$"},
          "count": {"type": "integer", "minimum": 1},
          "section": {"type": "string"},
          "related_variant": {"type": "string"},
          "note": {"type": "string"},
          "assistance": {
            "type": "object",
            "properties": {
              "permitted": {"type": "boolean"},
              "extra_penalty_ref": {"type": ["string", "null"]},
              "extra_penalty": {"type": "integer"},
              "note": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
